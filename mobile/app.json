{
  "expo": {
    "name": "AcquiSense Mobile",
    "slug": "acquisense-mobile",
    "version": "3.0.0",
    "scheme": "acquisense",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#07090E",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.acquisense.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#07090E"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AcquiSense to unlock confidential M&A dossiers."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow AcquiSense Pocket Copilot to transcribe your voice questions."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7960f69e-dcec-4f06-a3c0-abd325d509fb"
      }
    },
    "owner": "samradhsahni"
  }
}
