# For Android Emulator connecting to Podman Compose Gateway:
EXPO_PUBLIC_API_GATEWAY_URL=http://10.0.2.2:4100

# For Android Emulator connecting to local Node server (PORT=4000):
# EXPO_PUBLIC_API_GATEWAY_URL=http://10.0.2.2:4000

# For physical Android device over Wi-Fi (replace with your PC LAN IP):
# EXPO_PUBLIC_API_GATEWAY_URL=http://192.168.1.100:4100

