# ─────────────────────────────────────────────────────────────────────────────
#  Due Diligence Agents Platform — Environment Variables Template
#  Copy this to .env and fill in your values before running docker compose up
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=ddadmin
MONGO_ROOT_PASS=ddpassword
MONGO_DB=diligence

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASS=redispassword

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASS=grafanapassword

# ── Python Backend ───────────────────────────────────────────────────────────
OPENAI_MODEL_DOMAIN=gpt-4o-mini       # Domain specialist agents (9 agents)
OPENAI_MODEL_SYNTHESIS=gpt-4o         # Synthesis + Quality Gate agents
OPENAI_MODEL_REPORT=gpt-4o            # Report generation agent
MAX_PARALLEL_AGENTS=9                 # How many domain agents run at once
CHUNK_SIZE=1000                       # Document chunk size (tokens)
CHUNK_OVERLAP=200                     # Overlap between chunks

# ── Node.js Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
JWT_SECRET=change-this-to-a-random-secret-in-production

# ── Bull Queue ───────────────────────────────────────────────────────────────
BULL_CONCURRENCY=2                    # Max simultaneous analysis jobs
JOB_TIMEOUT_MS=900000                 # 15 minutes per job

# ── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,xlsx,pptx,txt,csv,md
