{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Deal pipeline overview — queue depth, active deals, completion rate",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jobs Queued",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [{ "expr": "pipeline_jobs_total{status='queued'}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs Running",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        }
      },
      "targets": [{ "expr": "active_jobs_current", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jobs Completed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      },
      "targets": [{ "expr": "pipeline_jobs_total{status='done'}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobs Failed",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "pipeline_jobs_total{status='failed'}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pipeline Job Rate (5m avg)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 15 }, "unit": "reqps" }
      },
      "targets": [
        { "expr": "rate(pipeline_jobs_total{status='queued'}[5m])", "legendFormat": "Queued/s", "refId": "A" },
        { "expr": "rate(pipeline_jobs_total{status='done'}[5m])", "legendFormat": "Done/s", "refId": "B" },
        { "expr": "rate(pipeline_jobs_total{status='failed'}[5m])", "legendFormat": "Failed/s", "refId": "C" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["due-diligence", "pipeline"],
  "templating": {
    "list": [{ "name": "DS_PROMETHEUS", "query": "prometheus", "refresh": 1, "type": "datasource" }]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Deal Pipeline",
  "uid": "dd-deal-pipeline",
  "version": 1
}
